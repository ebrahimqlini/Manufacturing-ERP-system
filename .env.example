# Example only: Django does not load .env automatically. Use these as process
# environment variables or configure a local dotenv loader separately.

# Local development / fast smoke tests (SQLite).
DJANGO_DEBUG=true
# Optional in local debug; Django creates an ephemeral key if omitted.
# DJANGO_SECRET_KEY=<generate-locally>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# PostgreSQL development/integration example. Do not copy the placeholder
# password literally. Supply it locally; never commit a real .env.
# DB_ENGINE=postgres
# DB_NAME=test_paper_factory
# DB_USER=paper_factory_app
# DB_PASSWORD=<set-locally>
# DB_HOST=127.0.0.1
# DB_PORT=5432

# For production, set DJANGO_DEBUG=false, a persistent DJANGO_SECRET_KEY,
# the production DJANGO_ALLOWED_HOSTS, and production database values in the
# deployment environment. HTTPS is required; HSTS remains opt-in until the
# deployed hostname and proxy are verified.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=<set-in-secret-store>
# DJANGO_ALLOWED_HOSTS=<production-hostnames>
# DJANGO_SECURE_HSTS_SECONDS=<approved-seconds>

# PostgreSQL integration tests must use a dedicated disposable test database.
# Django's test runner creates a test DB; give CREATEDB only to a dedicated
# test role, or pre-create/configure that test DB using a controlled process.
