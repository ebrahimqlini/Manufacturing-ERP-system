# Example only: Django does not load this file automatically. Set these values
# in the process environment or use a local dotenv loader that is not committed.
DJANGO_DEBUG=true
# Optional for local development; omitted local keys are generated per process.
# DJANGO_SECRET_KEY=replace-with-a-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite can be selected explicitly for development/test runs.
DB_ENGINE=sqlite

# Production/local integration example. Set every value; no database, role,
# host, port, or password is assumed by Django settings.
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=replace-with-a-random-value
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set HSTS only after the HTTPS hostname and proxy behavior are confirmed.
# DJANGO_SECURE_HSTS_SECONDS=<approved-seconds>
# DB_ENGINE=postgres
# DB_NAME=your_database_name
# DB_USER=erp_app
# DB_PASSWORD=replace-locally
# DB_HOST=127.0.0.1
# DB_PORT=5432
